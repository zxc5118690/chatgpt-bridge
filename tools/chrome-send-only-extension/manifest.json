{
  "manifest_version": 3,
  "key": "",
  "name": "ChatGPT Send-Only Bridge",
  "version": "0.1.0",
  "description": "Submits prompts from a loopback bridge without reading ChatGPT output.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ChatGPT Send-Only Bridge"
  }
}
